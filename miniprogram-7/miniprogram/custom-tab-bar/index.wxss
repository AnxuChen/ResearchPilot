.nav-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  padding: 0 18rpx;
  pointer-events: auto;
}

.nav-container {
  position: relative;
  border-top-left-radius: 56rpx;
  border-top-right-radius: 56rpx;
  border: 1rpx solid rgba(226, 232, 240, 0.8);
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 -10rpx 36rpx rgba(15, 23, 42, 0.08);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  padding: 20rpx 4rpx calc(env(safe-area-inset-bottom) + 8rpx);
}

.tabs-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.tab-item {
  width: 20%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  opacity: 0.45;
  transition: opacity 180ms ease;
}

.tab-item-active {
  opacity: 1;
}

.tab-placeholder {
  width: 20%;
  height: 80rpx;
}

.tab-icon-wrap {
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-item-active .tab-icon-wrap {
  background: linear-gradient(135deg, #2dd4bf 0%, #5eead4 100%);
  box-shadow: 0 12rpx 24rpx rgba(45, 212, 191, 0.3);
}

.tab-icon {
  width: 38rpx;
  height: 38rpx;
}

.tab-label {
  margin-top: 8rpx;
  font-size: 18rpx;
  line-height: 1;
  font-weight: 700;
  letter-spacing: 0.8rpx;
  color: #64748b;
}

.tab-item-active .tab-label {
  color: #0d9488;
}

.center-fab {
  position: absolute;
  left: 50%;
  top: -34rpx;
  transform: translateX(-50%);
  width: 112rpx;
  height: 112rpx;
  border-radius: 56rpx;
  border: 8rpx solid #ffffff;
  background: linear-gradient(135deg, #2dd4bf 0%, #f472b6 55%, #fb923c 100%);
  box-shadow: 0 18rpx 34rpx rgba(244, 114, 182, 0.32);
  display: flex;
  align-items: center;
  justify-content: center;
}

.fab-icon {
    width: 52rpx;
    height: 52rpx;
  }

/* 遮罩 */
.modal-mask {
    position: fixed;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background: rgba(15, 23, 42, 0.4);
    display: flex;
    justify-content: center;
    align-items: flex-end;
    z-index: 2000;
  }
  
  /* 底部弹窗 */
  .modal-content {
    width: 100%;
    background: #ffffff;
    border-top-left-radius: 36rpx;
    border-top-right-radius: 36rpx;
    padding: 40rpx 28rpx calc(env(safe-area-inset-bottom) + 40rpx);
    animation: slideUp 220ms ease;
  }
  
  /* 动画 */
  @keyframes slideUp {
    from {
      transform: translateY(100%);
    }
    to {
      transform: translateY(0);
    }
  }
  
  /* 搜索行 */
  .search-row {
    display: flex;
    align-items: center;
    gap: 20rpx;
  }
  
  /* 输入框 */
  .search-input {
    flex: 1;
    height: 120rpx;
    background: #f1f5f9;
    border-radius: 44rpx;
    padding: 0 30rpx;
    font-size: 28rpx;
    color: #334155;
  }
  
  /* 搜索按钮 */
  .search-btn {
    width: 160rpx;
    height: 86rpx;
    border-radius: 44rpx;
    background: linear-gradient(135deg, #2dd4bf 0%, #60a5fa 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    font-size: 30rpx;
    font-weight: 600;
    box-shadow: 0 10rpx 24rpx rgba(96, 165, 250, 0.35);
  }

  /* 顶部区域 */
.modal-header {
    position: relative;
    height: 40rpx;
    margin-bottom: 30rpx;
    display: flex;
    justify-content: flex-end;
    align-items: center;
  }
  
  /* 关闭按钮 */
  .close-btn {
    width: 60rpx;
    height: 60rpx;
    border-radius: 30rpx;
    background: #f1f5f9;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 30rpx;
    color: #64748b;
    box-shadow: 0 6rpx 16rpx rgba(15, 23, 42, 0.08);
  }
  
  .close-btn:active {
    transform: scale(0.95);
  }
