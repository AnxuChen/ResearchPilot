<view class="nav-shell">
  <view class="nav-container">
    <view class="tabs-row">
      <block wx:for="{{leftTabs}}" wx:key="pagePath">
        <view
          class="tab-item {{selectedPath === item.pagePath ? 'tab-item-active' : ''}}"
          data-path="{{item.pagePath}}"
          bindtap="onTapTab"
        >
          <view class="tab-icon-wrap">
            <image
              class="tab-icon"
              src="{{selectedPath === item.pagePath ? item.selectedIconPath : item.iconPath}}"
              mode="aspectFit"
            />
          </view>
          <text class="tab-label">{{item.text}}</text>
        </view>
      </block>

      <view class="tab-placeholder"></view>

      <block wx:for="{{rightTabs}}" wx:key="pagePath">
        <view
          class="tab-item {{selectedPath === item.pagePath ? 'tab-item-active' : ''}}"
          data-path="{{item.pagePath}}"
          bindtap="onTapTab"
        >
          <view class="tab-icon-wrap">
            <image
              class="tab-icon"
              src="{{selectedPath === item.pagePath ? item.selectedIconPath : item.iconPath}}"
              mode="aspectFit"
            />
          </view>
          <text class="tab-label">{{item.text}}</text>
        </view>
      </block>
    </view>

<!-- 中间悬浮按钮 -->
<view class="center-fab" bindtap="openSearchModal">
    <image 
    class="fab-icon"
    src="/images/tabbar/find.png"
    mode="aspectFit"
  />
</view>

<!-- 搜索弹窗 -->
<view wx:if="{{showSearchModal}}" class="modal-mask" bindtap="closeSearchModal">
  <view class="modal-content" catchtap="preventClose">
    
      <!-- 顶部关闭按钮 -->
  <view class="modal-header">
    <view class="close-btn" bindtap="closeSearchModal">
      ✕
    </view>
  </view>

    <view class="search-row">
      <input 
        class="search-input"
        value="{{searchKeyword}}"
        placeholder="输入关键词检索论文，留空使用默认"
        bindinput="onInputChange"
        confirm-type="search"
        bindconfirm="onSearchConfirm"
      />
      <view class="search-btn" bindtap="onSearchTap">
        <text wx:if="{{!searchLoading}}">搜索</text>
        <text wx:else>检索中...</text>
      </view>
    </view>

  </view>
</view>
  </view>
</view>
