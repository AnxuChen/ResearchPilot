<view class="container">
  <view class="nav-bar">
    <view class="brand">
      <view class="brand-icon">
        <view class="flask-icon"></view>
      </view>
      <text class="brand-text">DISCOVERY</text>
    </view>
    <view class="top-btns">
      <view class="icon-btn" bindtap="onSwitchToCard">
        <image class="btn-image" src="/images/explore/change.png" mode="aspectFit"></image>
      </view>
    </view>
  </view>

  <view class="page-header">
    <view class="title-line">{{language === 'zh' ? '探索' : 'Explore'}}</view>
    <view class="title-line highlight">{{language === 'zh' ? '灵感新知' : 'Fresh Ideas'}}</view>
  </view>

  <view class="search-panel">
    <input
      class="search-input"
      type="text"
      value="{{keywords}}"
      bindinput="onKeywordInput"
      bindconfirm="onSearchTap"
      confirm-type="search"
      placeholder="{{language === 'zh' ? '输入关键词检索论文（留空使用默认）' : 'Search papers by keywords (leave empty for default)'}}"
    />
    <button class="search-btn" loading="{{isLoading}}" bindtap="onSearchTap">{{language === 'zh' ? '搜索' : 'Search'}}</button>
  </view>
  <view class="search-meta">
    <text class="search-meta-text">
      {{language === 'zh' ? '当前关键词：' : 'Current keywords: '}}{{appliedKeywords || (language === 'zh' ? '默认' : 'default')}}
    </text>
  </view>
  <view wx:if="{{source==='local_cache'}}" class="search-warning">
    {{language === 'zh' ? 'OpenAlex 请求失败，已自动回退到本地缓存。' : 'OpenAlex request failed. Fallback to local cache.'}}
  </view>

  <view wx:if="{{isLoading}}" class="state-text">{{language === 'zh' ? '正在获取推荐论文...' : 'Loading recommended papers...'}}</view>
  <view wx:elif="{{errorMsg}}" class="state-text state-error">{{errorMsg}}</view>
  <view wx:elif="{{!papers.length}}" class="state-text">{{language === 'zh' ? '暂无结果，换个关键词试试。' : 'No results. Try different keywords.'}}</view>

  <view wx:else class="discovery-grid">
    <view class="grid-column">
      <view class="card idea-card" wx:for="{{leftPapers}}" wx:key="id" bindtap="onPaperTap" data-id="{{item.id}}">
        <view class="card-content">
          <view class="tag-label mint-text">{{item.yearText}}</view>
          <view class="card-title">{{item.title}}</view>
          <view class="card-abstract">{{item.abstractShort}}</view>
          <view class="card-footer">
            <text class="author-text">{{item.authorsText}}</text>
            <view class="meta-right">
              <text class="time-text">{{item.citationText}}</text>
              <view
                class="paper-like-btn {{item.likedByMe ? 'active' : ''}}"
                data-id="{{item.id}}"
                data-liked="{{item.likedByMe}}"
                catchtap="onTogglePaperLike"
              >
                {{item.likedByMe ? (language === 'zh' ? '已赞' : 'Liked') : (language === 'zh' ? '点赞' : 'Like')}}
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="grid-column">
      <view class="card idea-card" wx:for="{{rightPapers}}" wx:key="id" bindtap="onPaperTap" data-id="{{item.id}}">
        <view class="card-content">
          <view class="tag-label blue-text">{{item.yearText}}</view>
          <view class="card-title">{{item.title}}</view>
          <view class="card-abstract">{{item.abstractShort}}</view>
          <view class="card-footer">
            <text class="author-text">{{item.authorsText}}</text>
            <view class="meta-right">
              <text class="time-text">{{item.citationText}}</text>
              <view
                class="paper-like-btn {{item.likedByMe ? 'active' : ''}}"
                data-id="{{item.id}}"
                data-liked="{{item.likedByMe}}"
                catchtap="onTogglePaperLike"
              >
                {{item.likedByMe ? (language === 'zh' ? '已赞' : 'Liked') : (language === 'zh' ? '点赞' : 'Like')}}
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
