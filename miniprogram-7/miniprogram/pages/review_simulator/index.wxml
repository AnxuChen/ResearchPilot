<view class="page">
  <view class="hero">
    <text class="title">Review Simulator</text>
    <text class="desc">Upload your manuscript. The AI reviewer will provide comments, a score, and an acceptance recommendation.</text>
  </view>

  <view class="upload-card">

<!-- Upload area -->
<view class="upload-area" bindtap="onChooseFile">
  <view class="upload-icon">
    <text class="icon-text">☁</text>
  </view>

  <text class="upload-title">Upload Files</text>
  <text class="upload-sub">(PDF/TXT/MD)</text>

  <view class="file-meta" wx:if="{{selectedFileName}}">
    <text class="file-name">{{selectedFileName}}</text>
    <text class="file-sub">{{selectedFileSizeText}}</text>
  </view>
</view>

<!-- Start review button -->
<button
  class="start-btn-new"
  bindtap="onStartReview"
  loading="{{isReviewing}}"
  disabled="{{isReviewing}}"
>
  {{isReviewing ? 'Reviewing...' : 'Start Review'}}
</button>

<text class="task-status" wx:if="{{isReviewing}}">
  Task Status: {{reviewStatus || 'PENDING'}}
</text>

</view>

  <view class="result-card" wx:if="{{reviewResult}}">
    <view class="result-top">
      <text class="decision">{{reviewResult.decision}}</text>
      <text class="score">Score {{reviewResult.score}} / 10</text>
    </view>

    <view class="block">
      <text class="block-title">Summary</text>
      <text class="block-text">{{reviewResult.summary}}</text>
    </view>

    <view class="block" wx:if="{{reviewResult.strengths.length}}">
      <text class="block-title">Strengths</text>
      <view class="item" wx:for="{{reviewResult.strengths}}" wx:key="*this">
        <text class="dot">•</text>
        <text class="item-text">{{item}}</text>
      </view>
    </view>

    <view class="block" wx:if="{{reviewResult.weaknesses.length}}">
      <text class="block-title">Weaknesses</text>
      <view class="item" wx:for="{{reviewResult.weaknesses}}" wx:key="*this">
        <text class="dot">•</text>
        <text class="item-text">{{item}}</text>
      </view>
    </view>

    <view class="block" wx:if="{{reviewResult.suggestions.length}}">
      <text class="block-title">Suggestions</text>
      <view class="item" wx:for="{{reviewResult.suggestions}}" wx:key="*this">
        <text class="dot">•</text>
        <text class="item-text">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- Recent reviews -->
  <view class="recent-section">
    <view class="section-header">
      <text class="section-title">Recent Simulations</text>
      <text class="view-all">{{recentItems.length}} items</text>
    </view>

    <view wx:if="{{isRecentLoading}}" class="recent-empty">
      Loading recent simulations...
    </view>
    <view wx:elif="{{!recentItems.length}}" class="recent-empty">
      No review history yet. Start one simulation to generate records.
    </view>
    <view wx:else>
      <view
        class="recent-card"
        wx:for="{{recentItems}}"
        wx:key="id"
        data-index="{{index}}"
        bindtap="onTapRecentSimulation"
      >
        <view class="file-icon {{item.iconClass}}"></view>
        <view class="recent-info">
          <text class="recent-name">{{item.fileName}}</text>
          <text class="recent-time">{{item.timeText}}</text>
        </view>
        <view class="recent-score">
          <text class="score-num">{{item.scoreText}}</text>
          <text class="score-label">{{item.decision}}</text>
          <view
            class="recent-delete-btn"
            data-id="{{item.id}}"
            catchtap="onDeleteRecentSimulation"
          >
            Delete
          </view>
        </view>
      </view>
    </view>
  </view>


  <!-- Review tips -->
  <view class="tips-section">
    <view class="tips-header">
      <text class="tips-title">Review Guide (Pro Tips)</text>
    </view>

    <view class="tip-item">
      <view class="tip-num">1</view>
      <view class="tip-content">
        <text class="tip-bold">Completeness:</text>
        <text>Ensure the uploaded file includes a full title, abstract, and main content.</text>
      </view>
    </view>

    <view class="tip-item">
      <view class="tip-num">2</view>
      <view class="tip-content">
        <text class="tip-bold">Scope:</text>
        <text>The AI review follows general academic standards and is for reference only.</text>
      </view>
    </view>

    <view class="tip-item">
      <view class="tip-num">3</view>
      <view class="tip-content">
        <text class="tip-bold">Privacy:</text>
        <text>Your data is handled carefully, and manuscripts are encrypted after processing.</text>
      </view>
    </view>
  </view>  
</view>
