<view class="page">
  <view class="card">
    <text class="title">Complete WeChat Profile</text>
    <text class="desc">For first-time WeChat sign in, please add nickname and avatar for your profile.</text>

    <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image class="avatar-img" src="{{displayAvatarUrl}}" mode="aspectFill"></image>
      <text class="avatar-text">Choose Avatar</text>
    </button>

    <input
      class="nickname-input"
      type="nickname"
      placeholder="Enter nickname"
      value="{{nickname}}"
      bindinput="onEditNicknameInput"
    />

    <button class="save-btn" loading="{{isSaving}}" bindtap="onSaveProfile">
      Save and Continue
    </button>
  </view>
</view>
