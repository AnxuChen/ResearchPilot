<!--pages/register/register.wxml-->
<view class="page">

<!-- Background -->
<view class="blob sunny"></view>
<view class="blob orange"></view>
<view class="blob pink"></view>


<!-- Floating Icons -->
<text class="float-icon science">⚗️</text>
<text class="float-icon edit">✏️</text>

<!-- Header -->
<view class="header">
  <view class="logo">
    <text class="cap">🎓</text>
    <text class="spark">✨</text>
  </view>

  <text class="title">Join the Lab</text>
  <text class="subtitle">
    Create your playground to explore,
    design, and manage research.
  </text>
</view>

<!-- Form -->
<view class="form">

  <view class="field">
    <text class="label">Full Name</text>
    <view class="input-box">
      <text class="icon">👤</text>
      <input
        value="{{fullName}}"
        bindinput="onInputFullName"
        placeholder="e.g. Marie Curie"
      />
    </view>
  </view>

  <view class="field">
    <text class="label">Academic Email</text>
    <view class="input-box">
      <text class="icon">✉️</text>
      <input
        value="{{email}}"
        bindinput="onInputEmail"
        placeholder="name@university.edu"
      />
    </view>
  </view>

  <view class="field">
    <text class="label">Field of Study</text>
    <view class="input-box">
      <text class="icon">🔬</text>
      <input
        value="{{fieldOfStudy}}"
        bindinput="onInputFieldOfStudy"
        placeholder="e.g. Neuroscience"
      />
    </view>
  </view>

  <view class="field">
    <text class="label">Password</text>
    <view class="input-box">
      <text class="icon">🔒</text>
      <input
        value="{{password}}"
        bindinput="onInputPassword"
        password
        placeholder="Create a strong password (>=8)"
      />
    </view>
  </view>

  <!-- Sign Up -->
  <view class="btn primary" bindtap="onSignUp">
    <text>Sign Up →</text>
  </view>

  <!-- Login Entry -->
  <view class="login-tip">
    Already have a lab pass?
    <text class="login-link" bindtap="goLogin">Log in</text>
  </view>

</view>

</view>
