<!--pages/lab/index.wxml-->
<view class="container">
  <view class="header-wrapper">
    <view class="left-column">
      <view class="brand {{language === 'zh' ? 'brand-zh' : ''}}">
        <view class="logo-box">
          <image class="icon-img" src="/images/lab/lab.png" mode="aspectFit"></image> 
        </view>
        <text class="brand-name">AI LAB</text>
      </view>

      <view class="title-section {{language === 'zh' ? 'title-section-zh' : ''}}">
        <view class="title-main">{{language === 'zh' ? '选择' : 'Select'}}</view>
        <view class="title-gradient">{{language === 'zh' ? '研究工具' : 'Research Tool'}}</view>
      </view>
    </view>

  </view>

  <view class="card card-large">
    <view class="card-header">
      <view class="icon-large-box bg-teal-gradient">
        <image class="icon-xl" src="/images/lab/robot.png"></image>
      </view>
      <view class="badge badge-popular">
        <text class="badge-icon">⚡</text>
        <text>POPULAR</text>
      </view>
    </view>
    
    <view class="card-body">
      <text class="card-title">{{language === 'zh' ? '审稿模拟器' : 'Review Simulator'}}</text>
      <text class="card-desc">
        {{language === 'zh' ? '使用先进大模型模拟同行评审反馈，生成评分与录用建议。' : 'Simulate peer review feedback using advanced LLMs trained on top-tier journals.'}}
      </text>
    </view>

    <view class="card-footer">
      <button class="btn-launch" bindtap="onLaunchReviewSimulator">
        {{language === 'zh' ? '启动' : 'LAUNCH'}} <text class="arrow">→</text>
      </button>
    </view>
  </view>

  <view class="card card-row" bindtap="onLaunchAcademicPls">
    <view class="icon-medium-box bg-orange-gradient">
      <image class="icon-lg" src="/images/lab/wand.png"></image>
    </view>
    <view class="card-row-content">
      <view class="flex-row">
        <text class="card-subtitle">{{language === 'zh' ? '学术润色' : 'Academic Polisher'}}</text>
        <view class="badge-new">{{language === 'zh' ? '新' : 'NEW'}}</view>
      </view>
      <text class="card-desc-sm">
        {{language === 'zh' ? '提升论文草稿的语气、清晰度与简洁性。' : 'Refine tone, clarity, and conciseness for your manuscript drafts.'}}
      </text>
      
      <view class="progress-bg">
        <view class="progress-fill" style="width: 75%;"></view>
      </view>
      
      <view class="card-meta">
        <text class="meta-gray">{{language === 'zh' ? '准确率提升 75%' : '75% Accuracy Boost'}}</text>
        <text class="meta-orange">{{language === 'zh' ? 'v2.0 测试版' : 'v2.0 BETA'}}</text>
      </view>
    </view>
  </view>

  <view class="grid-section">
    <view class="card grid-item" bindtap="onLaunchDataViz">
      <view class="icon-circle bg-blue-light">
        <image class="icon-md" src="/images/lab/chart.png"></image>
      </view>
      <text class="grid-title">{{language === 'zh' ? '数据可视化' : 'Data Viz'}}</text>
      <text class="grid-desc">{{language === 'zh' ? 'CSV 转图表' : 'CSV to Chart'}}</text>
    </view>

    <view class="card grid-item" bindtap="onLaunchCitations">
      <view class="icon-circle bg-pink-light">
        <image class="icon-md" src="/images/lab/cite.png"></image>
      </view>
      <text class="grid-title">{{language === 'zh' ? '引用格式' : 'Citations'}}</text>
      <text class="grid-desc">{{language === 'zh' ? '自动格式化' : 'Auto-Format'}}</text>
    </view>
  </view>

  <view class="list-section">
    <view class="section-header">
      <view class="flex-row">
        <text class="section-title">{{language === 'zh' ? '最近阅读' : 'Recent Reading'}}</text>
        <view class="badge-count">
          {{recentReadings.length}} {{language === 'zh' ? '条' : 'ITEMS'}}
        </view>
      </view>
    </view>

    <view wx:if="{{recentReadingLoading && recentReadings.length === 0}}" class="card list-item list-empty">
      <text class="list-empty-text">{{language === 'zh' ? '正在加载最近阅读...' : 'Loading recent reading...'}}</text>
    </view>

    <view wx:elif="{{recentReadings.length === 0}}" class="card list-item list-empty">
      <text class="list-empty-text">{{language === 'zh' ? '暂无最近阅读。' : 'No recent reading yet.'}}</text>
    </view>

    <block wx:else>
      <view
        class="card list-item"
        wx:for="{{recentReadings}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onOpenRecentReading"
      >
        <view class="icon-square">
          <image class="icon-md" src="/images/lab/brain.png"></image>
        </view>
        <view class="list-content">
          <text class="list-title">{{item.title}}</text>
          <view class="list-meta">
            <text class="tag-running">{{language === 'zh' ? '已读' : 'READ'}}</text>
            <text class="time-ago">{{item.readAtText}}</text>
          </view>
        </view>
        <text class="arrow-gray">></text>
      </view>
    </block>
  </view>

  <view style="height: 120px;"></view>
</view>
