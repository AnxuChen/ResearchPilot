<view class="page">
  <view class="card">
    <text class="title">Profile Settings</text>
    <text class="desc">Update your avatar and nickname.</text>

    <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image class="avatar-img" src="{{displayAvatarUrl}}" mode="aspectFill"></image>
      <text class="avatar-text">Choose Avatar</text>
    </button>

    <input
      class="nickname-input"
      type="nickname"
      placeholder="Enter your nickname"
      value="{{nickname}}"
      bindinput="onInputNickname"
    />

    <view class="language-section">
      <text class="language-title">Language</text>
      <text class="language-desc">Choose your preferred app language.</text>
      <view class="language-options">
        <view
          wx:for="{{languageOptions}}"
          wx:key="value"
          class="language-chip {{selectedLanguage === item.value ? 'language-chip-active' : ''}}"
          data-value="{{item.value}}"
          bindtap="onSelectLanguage"
        >
          {{item.label}}
        </view>
      </view>
    </view>

    <view class="badge-section">
      <text class="badge-section-title">Profile Tag</text>
      <text class="badge-section-desc">Choose a style and customize the label shown on your avatar.</text>

      <view class="badge-current {{selectedBadgeClass}}">
        <text class="badge-current-icon">{{selectedBadgeIcon}}</text>
        <text class="badge-current-text">{{badgeText || selectedBadgeFallbackText}}</text>
      </view>

      <view class="badge-grid">
        <view
          class="badge-option {{selectedBadgeKey === item.key ? 'badge-option-selected' : ''}}"
          wx:for="{{badgeOptions}}"
          wx:key="key"
          data-key="{{item.key}}"
          bindtap="onSelectBadgeStyle"
        >
          <view class="badge-option-chip {{item.className}}">
            <text class="badge-option-icon">{{item.icon}}</text>
            <text class="badge-option-text">{{item.previewText}}</text>
          </view>
        </view>
      </view>

      <input
        class="badge-input"
        type="text"
        maxlength="24"
        placeholder="Enter tag text"
        value="{{badgeText}}"
        bindinput="onInputBadgeText"
      />
    </view>

    <button class="save-btn" loading="{{isSaving}}" bindtap="onSaveProfile">
      Save
    </button>
  </view>
</view>
