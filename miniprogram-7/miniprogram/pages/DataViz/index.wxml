<!--pages/DataViz/index.wxml-->
<view class="page">

<!-- 渐变背景 -->
<view class="bg">
  <view class="g g1"></view>
  <view class="g g2"></view>
  <view class="g g3"></view>
  <view class="g g4"></view>
</view>

<!-- 标题 -->
<view class="header">
  <text class="title">Create</text>
  <text class="title-gradient">Data Viz</text>
</view>

<!-- Upload Card -->
<view class="card upload-card">
  <view>
    <text class="card-title">Upload Data</text>
  </view>
  <view>
    <text class="card-sub">Support for CSV, JSON, or Excel files.</text>
  </view>

  <view class="upload-box" bindtap="onChooseFile">
    <view class="upload-icon">↑</view>
    <text class="upload-main">Tap to browse files</text>
    <text class="upload-sub">or drag and drop here</text>
  </view>
  <view wx:if="{{selectedFileName}}" class="file-meta">
    <text>{{selectedFileName}}</text>
    <text>{{selectedFileSizeText}}</text>
  </view>
</view>

<!-- Select Template -->
<view class="section">
  <view class="section-header">
    <text class="section-title">Select Template</text>
    <text class="view-all">VIEW ALL</text>
  </view>

  <!-- Line Chart -->
  <view
    class="card template-card {{selectedChartType === 'line' ? 'template-active' : ''}}"
    data-type="line"
    bindtap="onSelectChartType"
  >
    <view class="badge popular">POPULAR</view>

    <view class="template-row">
      <view class="icon blue">📈</view>
      <view>
        <text class="template-name">Line Chart</text>
        <text class="template-desc">Best for trends over time</text>
      </view>
    </view>

    <view class="progress">
      <view class="progress-bar"></view>
    </view>
  </view>

  <!-- Scatter -->
  <view
    class="card template-card {{selectedChartType === 'scatter' ? 'template-active' : ''}}"
    data-type="scatter"
    bindtap="onSelectChartType"
  >
    <view class="badge new">NEW</view>

    <view class="template-row">
      <view class="icon orange">●</view>
      <view>
        <text class="template-name">Scatter Plot</text>
        <text class="template-desc">Show relationships & clusters</text>
      </view>
    </view>

    <view class="dots">
      <view class="dot"></view>
      <view class="dot"></view>
      <view class="dot"></view>
      <view class="dot active"></view>
    </view>
  </view>

  <!-- Heatmap -->
  <view
    class="card template-card {{selectedChartType === 'heatmap' ? 'template-active' : ''}}"
    data-type="heatmap"
    bindtap="onSelectChartType"
  >
    <view class="template-row">
      <view class="icon red">▦</view>
      <view>
        <text class="template-name">Heatmap</text>
        <text class="template-desc">Visualize density & intensity</text>
      </view>
    </view>
  </view>

</view>

<view wx:if="{{chartOptionText || errorMsg || isGenerating}}" class="card output-card">
  <view class="output-head">
    <text class="output-title">{{chartTitle || 'Generated Visualization'}}</text>
    <text class="output-sub" wx:if="{{taskStatus}}">Status: {{taskStatus}}</text>
  </view>

  <view wx:if="{{isGenerating}}" class="state-text">AI 正在生成图表，请稍候...</view>
  <view wx:elif="{{errorMsg}}" class="state-text state-error">{{errorMsg}}</view>
  <view wx:else>
    <view wx:if="{{chartSummary}}" class="summary">{{chartSummary}}</view>
    <view wx:if="{{chartProvider}}" class="provider-pill">Provider: {{chartProvider}}</view>
    <view wx:if="{{chartInsights.length}}" class="insights">
      <view wx:for="{{chartInsights}}" wx:key="index" class="insight-item">• {{item}}</view>
    </view>
    <view wx:if="{{chartOption}}" class="chart-box">
      <canvas id="chartCanvas" canvas-id="chartCanvas" class="chart-canvas"></canvas>
    </view>
    <view wx:if="{{chartRenderHint}}" class="state-text">{{chartRenderHint}}</view>
    <view class="option-actions">
      <view class="copy-option-btn" bindtap="onToggleOptionText">
        {{showOptionText ? '隐藏配置 JSON' : '查看配置 JSON'}}
      </view>
      <view class="copy-option-btn copy-secondary" bindtap="onCopyChartOption">
        复制图表配置（ECharts Option）
      </view>
    </view>
    <view wx:if="{{showOptionText}}" class="option-box">
      <text class="option-text">{{chartOptionText}}</text>
    </view>
  </view>
</view>

<!-- Generate Button -->
<view class="bottom-area">
  <view class="generate-btn" bindtap="onGenerateChart">
    <text wx:if="{{isGenerating}}">GENERATING...</text>
    <text wx:else>GENERATE CHART →</text>
  </view>
</view>

</view>
