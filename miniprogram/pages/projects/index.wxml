<view class="container">
  <view class="nav-bar">
    <view class="brand">
      <view class="brand-icon">
        <view class="calendar-icon"></view>
      </view>
      <text class="brand-text">TRACKER</text>
    </view>
    <view class="menu-btn" bindtap="onAddConference">
      <text class="menu-btn-text">{{language === 'zh' ? '添加' : 'Add'}}</text>
    </view>
  </view>

  <view class="page-header">
    <view class="title-line">{{language === 'zh' ? '会议' : 'Conference'}}</view>
    <view class="title-line highlight">{{language === 'zh' ? '截止日期' : 'Deadlines'}}</view>
  </view>

  <view class="card featured-card"
      wx:if="{{featuredConf}}"
      bindtap="onEditConference"
      data-item="{{featuredConf}}">
    <view class="card-header">
      <view class="header-left">
        <view class="logo-box cvpr-logo">
          <text>{{featuredConf.abbr}}</text>
        </view>
        <view class="conference-info">
          <text class="conf-name">{{featuredConf.abbr}} {{featuredConf.year}}</text>
          <text class="conf-loc">📍 {{featuredConf.location}}</text>
        </view>
      </view>
      <view class="fire-badge">🔥</view>
    </view>
    
    <view class="deadline-row">
      <text class="label">{{language === 'zh' ? '投稿截止时间' : 'SUBMISSION DEADLINE'}}</text>
      <text class="days-left">{{featuredConf.timeLeftStr}} {{language === 'zh' ? '剩余' : 'Left'}}</text>
    </view>

    <view class="progress-track">
      <view class="progress-bar" style="width: {{featuredConf.progress}}"></view>
    </view>

    <view class="note-box" wx:if="{{featuredConf.note}}">
      <text class="note-label">{{language === 'zh' ? '备注：' : 'Note:'}}</text> {{featuredConf.note}}
    </view>
  </view>

  <view class="grid-container">
    <view class="card grid-card"
      wx:for="{{gridConfs}}"
      wx:key="id"
      bindtap="onEditConference"
      data-item="{{item}}">
      <view class="card-top-row">
        <text class="conf-label">{{language === 'zh' ? '会议' : 'CONF'}}</text>
        <view class="time-pill {{item.colorTheme}}-pill">{{item.timeLeftStr}}</view>
      </view>
      
      <view class="card-title">{{item.abbr}}</view>
      <view class="card-fullname">{{item.fullName}}</view>
      
      <view class="card-bottom">
        <view class="progress-info">
          <text>{{language === 'zh' ? '进度' : 'Progress'}}</text>
          <text>{{item.progress}}%</text>
        </view>
        <view class="progress-track small-track">
          <view class="progress-bar-small {{item.colorTheme}}-bg" style="width: {{item.progress}}"></view>
        </view>
      </view>
    </view>
  </view>
</view>

<!-- Modal -->
<view wx:if="{{showModal}}" class="modal-mask">

<view class="modal-container">

  <!-- Header -->
  <view class="modal-header">
    <text class="modal-title">
      {{isEdit ? (language === 'zh' ? '编辑会议' : 'Edit Conference') : (language === 'zh' ? '新增会议' : 'Add Conference')}}
    </text>

    <view class="close-btn" bindtap="closeModal">
      ✕
    </view>
  </view>

  <!-- Body -->
  <scroll-view scroll-y="true" class="modal-body">

    <view class="input-group">
      <text class="input-label">{{language === 'zh' ? '会议简称' : 'ABBREVIATION'}}</text>
    <view class="input-box">
      <text class="input-icon">ID</text>
      <input
        value="{{formData.abbr}}"
        data-field="abbr"
        bindinput="onInputChange"
        placeholder="{{language === 'zh' ? '例如 CVPR, NeurIPS' : 'e.g. CVPR, NeurIPS'}}"
        maxlength="10" 
      />
    </view>
    </view>

    <!-- Conference Name -->
    <view class="input-group">
      <text class="input-label">{{language === 'zh' ? '会议全称' : 'CONFERENCE NAME'}}</text>
      <view class="input-box">
        <text class="input-icon">🏷</text>
        <input
          value="{{formData.fullName}}"
          data-field="fullName"
          bindinput="onInputChange"
          placeholder="{{language === 'zh' ? '会议名称' : 'Conference Name'}}"
        />
      </view>
    </view>

    <!-- Location -->
    <view class="input-group">
      <text class="input-label">{{language === 'zh' ? '地点' : 'LOCATION'}}</text>
      <view class="input-box">
        <text class="input-icon">📍</text>
        <input
          value="{{formData.location}}"
          data-field="location"
          bindinput="onInputChange"
          placeholder="{{language === 'zh' ? '地点' : 'Location'}}"
        />
      </view>
    </view>

    <!-- Date Row -->
    <view class="date-row">

      <view class="input-group small">
        <text class="input-label">{{language === 'zh' ? '开始日期' : 'START DATE'}}</text>
        <view class="input-box">
          <text class="input-icon">📅</text>
          <input
            value="{{formData.startDate}}"
            data-field="startDate"
            bindinput="onInputChange"
            placeholder="2026-01-01"
          />
        </view>
      </view>

      <view class="input-group small">
        <text class="input-label">{{language === 'zh' ? '截止日期' : 'DEADLINE'}}</text>
        <view class="input-box deadline">
          <text class="input-icon red">⏰</text>
          <input
            class="deadline-text"
            value="{{formData.deadline}}"
            data-field="deadline"
            bindinput="onInputChange"
            placeholder="{{language === 'zh' ? '例如 2026-11-15' : 'e.g. 2026-11-15'}}"
          />
        </view>
      </view>

    </view>

    <!-- Category -->
    <view class="category-group">
      <text class="input-label">{{language === 'zh' ? '分类主题' : 'CATEGORY THEME'}}</text>

      <view class="category-group">
    <text class="input-label">{{language === 'zh' ? '颜色主题' : 'COLOR THEME'}}</text>
    <view class="category-grid">
      <view 
        wx:for="{{themeOptions}}" 
        wx:key="value"
        class="category-card {{formData.colorTheme === item.value ? 'active' : ''}}"
        bindtap="onSelectColor"
        data-theme="{{item.value}}"
      >
        <view class="color-box {{item.value}}-bg"></view>
        <text>{{item.name}}</text>
      </view>
    </view>
  </view>
    </view>

    <!-- Note -->
    <view class="input-group">
      <view class="note-label">
        <text class="input-label">{{language === 'zh' ? '备注' : 'NOTE'}}</text>
        <text class="optional">{{language === 'zh' ? '可选' : 'Optional'}}</text>
      </view>

      <view class="textarea-box">
        <textarea
          value="{{formData.note}}"
          data-field="note"
          bindinput="onInputChange"
          placeholder="{{language === 'zh' ? '补充说明...' : 'Add details...'}}"
        />
      </view>
    </view>

  </scroll-view>

  <!-- Footer -->
  <view class="modal-footer">
  <view style="display: flex; gap: 20rpx;">
    <button wx:if="{{isEdit}}" class="delete-btn" bindtap="onDeleteConference">
      <text>{{language === 'zh' ? '删除' : 'Delete'}}</text>
    </button>
    
    <button class="save-btn" style="flex: 1;" bindtap="onSaveConference">
      <text class="save-icon"></text>
      <text>{{isEdit ? (language === 'zh' ? '应用' : 'Apply') : (language === 'zh' ? '保存' : 'Save')}}</text>
    </button>
  </view>
</view>

</view>
</view>
