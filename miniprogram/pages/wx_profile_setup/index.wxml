<view class="page">
  <view class="card">
    <text class="title">{{language === 'zh' ? '完善微信资料' : 'Complete WeChat Profile'}}</text>
    <text class="desc">{{language === 'zh' ? '首次微信登录需要补充昵称和头像，用于个人资料展示。' : 'For first-time WeChat sign in, please add nickname and avatar for your profile.'}}</text>

    <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image class="avatar-img" src="{{displayAvatarUrl}}" mode="aspectFill"></image>
      <text class="avatar-text">{{language === 'zh' ? '选择头像' : 'Choose Avatar'}}</text>
    </button>

    <input
      class="nickname-input"
      type="nickname"
      placeholder="{{language === 'zh' ? '请输入昵称' : 'Enter nickname'}}"
      value="{{nickname}}"
      bindinput="onEditNicknameInput"
    />

    <button class="save-btn" loading="{{isSaving}}" bindtap="onSaveProfile">
      {{language === 'zh' ? '保存并进入' : 'Save and Continue'}}
    </button>
  </view>
</view>
