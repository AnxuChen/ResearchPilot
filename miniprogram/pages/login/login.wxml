<view class="page">

<!-- Background -->
<view class="blob blob-teal"></view>
<view class="blob blob-pink"></view>
<view class="blob blob-yellow"></view>

<!-- LOGO -->
<view class="logo-area">
  <view class="logo-card">
    <image class="icon-img" src="/images/login/logo.png" mode="aspectFit"></image>
    <view class="dot yellow"></view>
    <view class="dot teal"></view>
  </view>

  <view class="version">
    <view class="pulse"></view>
    <text>CREATIVE LAB V1.0</text>
  </view>
</view>

<!-- Title -->
<view class="title">
  <view>
    <text class="line">{{language === 'zh' ? '开启你的' : 'Start Your'}}</text>
  </view>
  <view>
    <text class="line gradient">{{language === 'zh' ? '科研之旅' : 'Research Journey'}}</text>
  </view>
</view>

<!-- Subtitle -->
<view class="subtitle">
  {{language === 'zh' ? '你的专属学术探索与智能研究平台。' : 'Your personal playground for academic discovery and neural optimization.'}}
</view>

<!-- Form -->
<view class="form">

  <view class="input-box">
    <input
      value="{{email}}"
      bindinput="onInputEmail"
      placeholder="{{language === 'zh' ? '学术邮箱' : 'Academic Email'}}"
      placeholder-class="placeholder"
    />
  </view>

  <view class="input-box">
    <input
      value="{{password}}"
      bindinput="onInputPassword"
      password
      placeholder="{{language === 'zh' ? '密码' : 'Password'}}"
      placeholder-class="placeholder"
    />
  </view>

  <view class="forgot">{{language === 'zh' ? '忘记密码？' : 'Forgot Password?'}}</view>

  <!-- Primary Action -->
  <view class="btn primary" bindtap="onSignIn">
    <text>{{language === 'zh' ? '登录' : 'Sign In'}} →</text>
  </view>

  <!-- Secondary Action -->
  <view class="btn secondary" bindtap="onCreate">
    <text>{{language === 'zh' ? '创建账号' : 'Create Account'}}</text>
  </view>

</view>

<!-- Third-party Sign In -->
<view class="other">
  <text class="other-text">{{language === 'zh' ? '或使用以下方式继续' : 'Or continue with'}}</text>
  <view class="icons">
    <view class="icon" bindtap="onWxSignIn">
      <image class="wx-icon-img" src="/images/weixin.png" mode="aspectFit"></image>
    </view>
  </view>
</view>

</view>
