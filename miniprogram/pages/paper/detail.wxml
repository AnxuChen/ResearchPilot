<view class="container">
  <view class="content-body" wx:if="{{paper}}">
    <view class="tag-header">
      <view 
        wx:for="{{paper.tags}}" 
        wx:key="index" 
        class="top-badge tag-color-{{index % 4}}"
      >{{item}}</view>
      <text class="date-text">{{paper.publishedText || '2026-02-19'}}</text>
    </view>

    <view class="main-title">{{paper.title}}</view>

    <view class="author-section">
      <view class="avatar-group">
        <view class="avatar-circle avt-1"></view>
        <view class="avatar-circle avt-2"></view>
      </view>
      <view class="author-info">
        <text class="author-name">{{paper.authorsText}}</text>
        <text class="author-role">{{language === 'zh' ? '主要作者' : 'PRIMARY AUTHORS'}}</text>
      </view>
    </view>

    <view class="abstract-flip-scene">
      <view class="abstract-flip-card {{isAbstractFlipped ? 'is-flipped' : ''}}">
        <view class="abstract-card abstract-face abstract-front">
          <view class="quote-icon">"</view>
          <view class="card-label">{{language === 'zh' ? '摘要' : 'Abstract'}}</view>
          <view class="abstract-text">{{paper.abstract}}</view>
          <view class="abstract-front-actions">
            <button
              class="ai-reading-btn"
              bindtap="onTapAiReading"
              loading="{{aiSummaryLoading}}"
              disabled="{{aiSummaryLoading}}"
            >
              AI Reading
            </button>
          </view>
        </view>

        <view class="abstract-card abstract-face abstract-back">
          <view class="quote-icon">AI</view>
          <view class="card-label">AI Reading</view>

          <view wx:if="{{aiSummaryLoading}}" class="ai-summary-state">
            {{language === 'zh' ? 'AI 正在阅读中...' : 'AI is reading...'}}
          </view>
          <view wx:elif="{{aiSummaryError}}" class="ai-summary-state ai-summary-error">
            {{aiSummaryError}}
          </view>
          <view wx:else class="ai-summary-text">{{aiSummaryText}}</view>

          <view class="abstract-back-actions">
            <button
              wx:if="{{aiSummaryError}}"
              class="ai-back-btn ai-retry-btn"
              bindtap="onRetryAiReading"
            >
              {{language === 'zh' ? '重试' : 'Retry'}}
            </button>
            <button class="ai-back-btn" bindtap="onBackToAbstract">
              {{language === 'zh' ? '返回摘要' : 'Back to Abstract'}}
            </button>
          </view>

          <view wx:if="{{aiSummaryFallback && !aiSummaryLoading && !aiSummaryError}}" class="ai-summary-tip">
            {{language === 'zh' ? '当前展示快速回退摘要。' : 'Showing fallback summary for now.'}}
          </view>
        </view>
      </view>
    </view>

    <view class="section-header">
      <text>{{language === 'zh' ? '论文信息' : 'Paper Metadata'}}</text>
    </view>

    <view class="insight-card">
      <view class="insight-icon icon-yellow"></view>
      <view class="insight-content">
        <text class="insight-title">{{language === 'zh' ? '引用' : 'Citations'}}</text>
        <text class="insight-desc">
          {{paper.citationCount}} {{language === 'zh' ? '次引用' : 'total citations'}}
        </text>
      </view>
    </view>

    <view class="insight-card">
      <view class="insight-icon icon-red"></view>
      <view class="insight-content">
        <text class="insight-title">{{language === 'zh' ? '发表来源' : 'Publication Venue'}}</text>
        <text class="insight-desc">{{paper.venue || (language === 'zh' ? 'ArXiv / 会议' : 'ArXiv / Conference')}}</text>
      </view>
    </view>
    <!-- Comments -->
<view class="discussion-section">
  <view class="discussion-header">
    <text class="discussion-title">{{language === 'zh' ? '评论' : 'Comments'}} ({{comments.length}})</text>
    <view class="comment-sort-group">
      <view
        class="sort-chip {{commentSortBy === 'time' ? 'active' : ''}}"
        data-sort="time"
        bindtap="onChangeCommentSort"
      >
        {{language === 'zh' ? '最新' : 'Latest'}}
      </view>
      <view
        class="sort-chip {{commentSortBy === 'likes' ? 'active' : ''}}"
        data-sort="likes"
        bindtap="onChangeCommentSort"
      >
        {{language === 'zh' ? '热门' : 'Top'}}
      </view>
    </view>
  </view>

  <view wx:if="{{commentsLoading}}" class="comment-state">{{language === 'zh' ? '正在加载评论...' : 'Loading comments...'}}</view>
  <view wx:elif="{{commentsError}}" class="comment-state comment-state-error">{{commentsError}}</view>
  <view wx:elif="{{!comments.length}}" class="comment-state">{{language === 'zh' ? '暂无评论，来发表第一条吧。' : 'No comments yet. Be the first one.'}}</view>

  <view wx:else>
    <view 
      wx:for="{{comments}}" 
      wx:key="id" 
      class="comment-card"
    >
      <view class="comment-avatar">
        {{item.initial}}
      </view>

      <view class="comment-body">
        <view class="comment-meta">
          <text class="comment-name">{{item.name}}</text>
          <text class="comment-time">{{item.timeText}}</text>
        </view>

        <view class="comment-text">
          {{item.content}}
        </view>

        <view class="comment-actions">
          <view
            class="comment-like-btn {{item.likedByMe ? 'active' : ''}}"
            data-id="{{item.id}}"
            bindtap="onToggleCommentLike"
          >
            👍 {{item.likeCount}}
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
    <view class="footer-spacer"></view>
  </view>

<!-- Bottom Input Bar -->
<view class="bottom-input-bar">
  <view class="action-buttons">
    <button class="action-btn btn-light" bindtap="onCopyLink">{{language === 'zh' ? '复制链接' : 'Copy Link'}}</button>
  </view>

  <view class="input-row">
    <view class="input-wrapper">
      <input 
        class="comment-input" 
        placeholder="{{language === 'zh' ? '写下你的评论...' : 'Add a comment...'}}" 
        confirm-type="send"
        bindconfirm="onSendComment"
        value="{{newComment}}"
        bindinput="onInputComment"
      />
      <view class="send-btn" bindtap="onSendComment">
        <text>➤</text>
      </view>
    </view>
    
    <view class="favorite-btn {{isFavorite ? 'active' : ''}}" bindtap="onToggleFavorite">
      <text class="fav-icon">{{isFavorite ? '❤️' : '♡'}}</text>
    </view>
  </view>
</view>
</view>
