<!--pages/DataViz/index.wxml-->
<view class="page">

<!-- Gradient Background -->
<view class="bg">
  <view class="g g1"></view>
  <view class="g g2"></view>
  <view class="g g3"></view>
  <view class="g g4"></view>
</view>

<!-- Header -->
<view class="header">
  <text class="title">{{language === 'zh' ? '创建' : 'Create'}}</text>
  <text class="title-gradient">{{language === 'zh' ? '数据可视化' : 'Data Viz'}}</text>
</view>

<!-- Upload Card -->
<view class="card upload-card">
  <view>
    <text class="card-title">{{language === 'zh' ? '上传数据' : 'Upload Data'}}</text>
  </view>
  <view>
    <text class="card-sub">{{language === 'zh' ? '支持 CSV、JSON 或 Excel 文件。' : 'Support for CSV, JSON, or Excel files.'}}</text>
  </view>

  <view class="upload-box" bindtap="onChooseFile">
    <view class="upload-icon">↑</view>
    <text class="upload-main">{{language === 'zh' ? '点击选择文件' : 'Tap to browse files'}}</text>
    <text class="upload-sub">{{language === 'zh' ? '或拖拽文件到此处' : 'or drag and drop here'}}</text>
  </view>
  <view wx:if="{{selectedFileName}}" class="file-meta">
    <text>{{selectedFileName}}</text>
    <text>{{selectedFileSizeText}}</text>
  </view>
</view>

<!-- Select Template -->
<view class="section">
  <view class="section-header">
    <text class="section-title">{{language === 'zh' ? '选择模板' : 'Select Template'}}</text>
    <text class="view-all">{{language === 'zh' ? '查看全部' : 'VIEW ALL'}}</text>
  </view>

  <!-- Line Chart -->
  <view
    class="card template-card {{selectedChartType === 'line' ? 'template-active' : ''}}"
    data-type="line"
    bindtap="onSelectChartType"
  >
    <view class="badge popular">{{language === 'zh' ? '热门' : 'POPULAR'}}</view>

    <view class="template-row">
      <view class="icon blue">📈</view>
      <view>
        <text class="template-name">{{language === 'zh' ? '折线图' : 'Line Chart'}}</text>
        <text class="template-desc">{{language === 'zh' ? '适合展示时间趋势' : 'Best for trends over time'}}</text>
      </view>
    </view>

    <view class="progress">
      <view class="progress-bar"></view>
    </view>
  </view>

  <!-- Scatter -->
  <view
    class="card template-card {{selectedChartType === 'scatter' ? 'template-active' : ''}}"
    data-type="scatter"
    bindtap="onSelectChartType"
  >
    <view class="badge new">{{language === 'zh' ? '新' : 'NEW'}}</view>

    <view class="template-row">
      <view class="icon orange">●</view>
      <view>
        <text class="template-name">{{language === 'zh' ? '散点图' : 'Scatter Plot'}}</text>
        <text class="template-desc">{{language === 'zh' ? '展示关系与聚类' : 'Show relationships & clusters'}}</text>
      </view>
    </view>

    <view class="dots">
      <view class="dot"></view>
      <view class="dot"></view>
      <view class="dot"></view>
      <view class="dot active"></view>
    </view>
  </view>

  <!-- Heatmap -->
  <view
    class="card template-card {{selectedChartType === 'heatmap' ? 'template-active' : ''}}"
    data-type="heatmap"
    bindtap="onSelectChartType"
  >
    <view class="template-row">
      <view class="icon red">▦</view>
      <view>
        <text class="template-name">{{language === 'zh' ? '热力图' : 'Heatmap'}}</text>
        <text class="template-desc">{{language === 'zh' ? '可视化密度与强度' : 'Visualize density & intensity'}}</text>
      </view>
    </view>
  </view>

</view>

<view wx:if="{{chartOptionText || errorMsg || isGenerating}}" class="card output-card">
  <view class="output-head">
    <text class="output-title">{{chartTitle || (language === 'zh' ? '生成可视化结果' : 'Generated Visualization')}}</text>
    <text class="output-sub" wx:if="{{taskStatus}}">{{language === 'zh' ? '状态' : 'Status'}}: {{taskStatus}}</text>
  </view>

  <view wx:if="{{isGenerating}}" class="state-text">{{language === 'zh' ? 'AI 正在生成图表，请稍候...' : 'AI is generating your chart, please wait...'}}</view>
  <view wx:elif="{{errorMsg}}" class="state-text state-error">{{errorMsg}}</view>
  <view wx:else>
    <view wx:if="{{chartSummary}}" class="summary">{{chartSummary}}</view>
    <view wx:if="{{chartProvider}}" class="provider-pill">{{language === 'zh' ? '提供方' : 'Provider'}}: {{chartProvider}}</view>
    <view wx:if="{{chartInsights.length}}" class="insights">
      <view wx:for="{{chartInsights}}" wx:key="index" class="insight-item">• {{item}}</view>
    </view>
    <view wx:if="{{chartOption}}" class="chart-box">
      <canvas id="chartCanvas" canvas-id="chartCanvas" class="chart-canvas"></canvas>
    </view>
    <view wx:if="{{chartRenderHint}}" class="state-text">{{chartRenderHint}}</view>
    <view class="option-actions">
      <view class="copy-option-btn" bindtap="onToggleOptionText">
        {{showOptionText ? (language === 'zh' ? '隐藏配置 JSON' : 'Hide Config JSON') : (language === 'zh' ? '查看配置 JSON' : 'View Config JSON')}}
      </view>
      <view class="copy-option-btn copy-secondary" bindtap="onCopyChartOption">
        {{language === 'zh' ? '复制图表配置（ECharts Option）' : 'Copy Chart Config (ECharts Option)'}}
      </view>
    </view>
    <view wx:if="{{showOptionText}}" class="option-box">
      <text class="option-text">{{chartOptionText}}</text>
    </view>
  </view>
</view>

<!-- Generate Button -->
<view class="bottom-area">
  <view class="generate-btn" bindtap="onGenerateChart">
    <text wx:if="{{isGenerating}}">{{language === 'zh' ? '生成中...' : 'GENERATING...'}}</text>
    <text wx:else>{{language === 'zh' ? '生成图表' : 'GENERATE CHART'}} →</text>
  </view>
</view>

</view>
